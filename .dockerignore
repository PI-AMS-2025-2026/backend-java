postman/
.postman/
*.pdf

# Metadados de versionamento e automação.
.git
.gitignore
.gitattributes
.github

# Configurações de IDE.
.idea
*.iml
*.iws
*.ipr
.vscode
.classpath
.project
.settings
.factorypath
.apt_generated

# Documentação (não é necessária em tempo de execução).
*.md
docs/
Pi_doc/

# Orquestração local e segredos.
docker-compose*
Dockerfile*
.dockerignore
.env*
!.env.example

# Diversos
.DS_Store
*.log
HELP.md
