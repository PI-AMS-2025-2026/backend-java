# Copie este arquivo para .env e substitua os valores CHANGE_ME:
#
#   cp .env.example .env
#   docker compose up -d --build
#
# O .env está no .gitignore e NUNCA deve ser versionado.
# Todas as variáveis abaixo são efetivamente lidas pelo docker-compose.yml.

# --- PostgreSQL (desenvolvimento local via docker compose) ---
POSTGRES_DB=gini
POSTGRES_USER=gini
POSTGRES_PASSWORD=CHANGE_ME
# Porta publicada no host (altere se a 5432 já estiver em uso).
DB_PORT=5432

# --- Aplicação ---
# Segredo de assinatura dos tokens JWT.
# Precisa ter 32+ caracteres e não pode ser um valor de exemplo: a aplicação
# recusa subir no perfil prod caso contrário.
# Gere um valor com: openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# Origens autorizadas a chamar a API pelo navegador (separadas por vírgula).
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Publica o Swagger UI e a especificação em /v3/api-docs.
# Default da aplicação: false (fechado). Localmente pode ficar true.
# Nos ambientes hospedados, ligar APENAS no ambiente de desenvolvimento e
# sempre com autenticação no proxy reverso à frente do serviço.
SWAGGER_ENABLED=true

# Identifica o ambiente: dev, staging ou production.
# Deriva o emissor dos tokens JWT (isolando os ambientes entre si) e bloqueia a
# publicação da documentação em produção.
# Default da aplicação: production (o valor mais restritivo).
APP_ENVIRONMENT=dev

# --- SMTP / recuperação de senha ---
# Aponta para o Mailpit, que sobe junto no compose e captura todos os e-mails
# localmente: http://localhost:8025
# Nenhuma mensagem sai da máquina com esta configuração.
#
# ATENÇÃO: não troque SMTP_HOST por um servidor real aqui. O compose usa o valor
# deste arquivo como está; apontar para um SMTP externo faz o fluxo de
# recuperação de senha tentar enviar e-mail de verdade a partir da sua máquina.
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=false
SMTP_STARTTLS=false
SMTP_FROM=noreply@gini.local
PASSWORD_RESET_EXPIRATION_MINUTES=15

# Portas publicadas pelo Mailpit no host (SMTP e interface web).
MAILPIT_SMTP_PORT=1025
MAILPIT_WEB_PORT=8025

# --- Frontend ---
# Usado para montar o link enviado no e-mail de recuperação de senha.
FRONTEND_URL=http://localhost:3000

# --- Opcionais (possuem padrão na aplicação) ---
# TOKEN_EXPIRATION_MS=86400000
# REFRESH_TOKEN_EXPIRATION_MS=604800000

# --- Não defina aqui ---
# SPRING_PROFILES_ACTIVE: o docker-compose.yml já fixa "prod" no serviço
# backend, então definir a variável neste arquivo não tem efeito.
#
# SPRING_DATASOURCE_URL / _USERNAME / _PASSWORD: o compose as monta a partir
# das variáveis POSTGRES_* acima.
#
# Para rodar o JAR com o perfil prod FORA do compose, exporte
# SPRING_DATASOURCE_URL/_USERNAME/_PASSWORD (ou, por compatibilidade,
# DB_URL/DB_USER/DB_PASSWORD, que o perfil prod aceita como alternativa).

# --- Usuário padrão do perfil dev ---
# login: adm@gini.com
# senha: 12345678
