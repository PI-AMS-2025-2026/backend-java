# Copie este arquivo para .env e substitua os valores CHANGE_ME.
# O .env está no .gitignore e NUNCA deve ser versionado.

# --- PostgreSQL (desenvolvimento local via docker compose) ---
POSTGRES_DB=gini
POSTGRES_USER=gini
POSTGRES_PASSWORD=CHANGE_ME
# Porta publicada no host (altere se a 5432 já estiver em uso).
DB_PORT=5432

# --- Aplicação ---
# Segredo de assinatura dos tokens JWT.
# Gere um valor forte com: openssl rand -hex 32
JWT_SECRET=CHANGE_ME

# Origens autorizadas a chamar a API pelo navegador (separadas por vírgula).
CORS_ALLOWED_ORIGINS=http://localhost:4200

# Publica o Swagger UI e a especificação em /v3/api-docs.
# Default da aplicação: false (fechado). Localmente pode ficar true.
# Nos ambientes hospedados, ligar APENAS no ambiente de desenvolvimento e
# sempre com autenticação no proxy reverso à frente do serviço.
SWAGGER_ENABLED=true

# Identifica o ambiente: dev, staging ou production.
# Deriva o emissor dos tokens JWT (isolando os ambientes entre si) e bloqueia a
# publicação da documentação em produção.
# Default da aplicação: production (o valor mais restritivo).
APP_ENVIRONMENT=dev

# --- Opcionais (possuem padrão na aplicação) ---
# TOKEN_EXPIRATION_MS=86400000
# REFRESH_TOKEN_EXPIRATION_MS=604800000
