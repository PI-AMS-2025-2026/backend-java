# Copie este arquivo para .env antes de executar: docker compose up --build

# --- PostgreSQL Variables (Used by the database container) ---
POSTGRES_USER=gini
POSTGRES_PASSWORD=altere-esta-senha
POSTGRES_DB=gini

# --- Spring Boot Variables (Used by your backend container) ---
DB_URL=jdbc:postgresql://postgres:5432/gini
DB_USER=gini
DB_PASSWORD=altere-esta-senha

JWT_SECRET=altere-este-segredo
TOKEN_EXPIRATION_MS=86400000
REFRESH_TOKEN_EXPIRATION_MS=604800000

SPRING_PROFILES_ACTIVE=prod

# --- SMTP / Password reset ---
# No Docker Compose, SMTP_HOST e SMTP_PORT são sobrescritos para mailpit:1025.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_AUTH=true
SMTP_STARTTLS=true
SMTP_FROM=noreply@example.com
PASSWORD_RESET_EXPIRATION_MINUTES=15

# --- Frontend ---
FRONTEND_URL=http://localhost:3000

# --- Usuario padrão do profile dev ---
# login: adm@gini.com
# senha: 12345678